{
  "name": "dreamcore-loader-home",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-link-meta.mjs && node scripts/check-assets.mjs && tsc -b && vite build",
    "check:assets": "node scripts/check-assets.mjs",
    "sync:link-meta": "node scripts/sync-link-meta.mjs",
    "test:api": "tsc api/visit.ts api/guestbook.ts api/admin.ts api/author.ts api/visitlog.ts api/insp.ts api/link-meta.ts api/chat.ts --outDir _apitest --module esnext --target es2022 --moduleResolution bundler --rewriteRelativeImportExtensions --skipLibCheck --types node && node scripts/api-selftest.mjs",
    "preview": "vite preview",
    "verify:devices": "node scripts/verify-device-images.mjs",
    "compress:glb": "node scripts/compress-glb.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "ws": "^8.21.3"
  }
}
